# MongoDB Database Connection URL
# For local MongoDB: mongodb://127.0.0.1:27017/ganesh_utsav_db
# For MongoDB Atlas Cloud: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ganesh_utsav_db?retryWrites=true&w=majority
MONGODB_URI="mongodb://127.0.0.1:27017/ganesh_utsav_db"

# Server Port (default 3000)
PORT=3000

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
